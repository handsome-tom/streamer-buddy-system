# Rules for streamspace.tv on Hostinger (Apache/LiteSpeed). GitHub Pages ignores this file.
# https is forced by hPanel's "Force HTTPS" switch (Security -> SSL), not here,
# so it can't loop behind Hostinger's CDN.
RewriteEngine On
RewriteBase /

# www.streamspace.tv -> streamspace.tv
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# The test site (test.streamspace.tv, the "staging" branch) lives in public_html/test.
# It is only reachable at its own address, never as streamspace.tv/test/.
RewriteCond %{HTTP_HOST} !^test\. [NC]
RewriteCond %{REQUEST_FILENAME} /public_html/test(/|$)
RewriteRule ^ - [F,L]

# Not part of the website: the Git folder, dev tools, notes.
# (relay/src stays reachable: the demo runs the relay's code in the page.)
RewriteRule ^(\.git|dev)(/|$) - [F,L]
RewriteRule ^(README\.md|\.gitignore|relay/wrangler\.toml)$ - [F,L]

# The demo is the front page: streamspace.tv/ shows demo/index.html.
# Typed or linked /demo/ goes to / so there's one address for it.
RewriteCond %{THE_REQUEST} \s/demo/(index\.html)?[\s?]
RewriteRule ^demo/(index\.html)?$ / [R=301,L]
# Front page with nothing after it = the demo. With ?something (?livechat, ?deck,
# ?embed=ext, the demo's own ?dev=... frames) it's still Streamer Buddy System's page.
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^(index\.html)?$ demo/index.html [L]
# The demo's own files (play.html, brand/, pics/, hub.js...) from the top level.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/demo/$1 -f
RewriteRule ^(.+)$ demo/$1 [L]

Options -Indexes
DirectoryIndex index.html

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType font/ttf .ttf
AddType image/webp .webp
AddType text/javascript .js

# Search engines leave the test site alone.
SetEnvIfNoCase Host ^test\. STAGING_SITE
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=STAGING_SITE
</IfModule>

# Pages and scripts check for a newer copy every time, so a push shows up right away.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|woff2|ttf|pdf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
